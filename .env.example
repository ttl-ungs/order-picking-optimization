# Local settings for the test runner (tests/support/config.py). Copy to .env.
# Write one CSV per run under results/<model>/<tier>/ (read by analysis/):
WRITE_RESULTS_CSV=0
# Per-test timeout in minutes for functional tests (default 25):
TEST_TIMEOUT_MINUTES=25
# Per-test timeout in minutes for stress tests (defaults to TEST_TIMEOUT_MINUTES; 40 was
# used for the ACO stress runs because some instances that do converge take 24-25 min):
STRESS_TEST_TIMEOUT_MINUTES=40
# opp_v5_2_split only: solve Stage 1's independent per-batch routing in parallel,
# with this many worker processes. Leave at 1 (sequential) to measure model times:
# parallel makes wall-clock depend on free CPU/RAM, so runs stop being reproducible
# and comparable against opp_v5_1_mono, which cannot decompose. Raise it only when
# you just want a long stress suite to finish and are not reading its timings.
OPP_STAGE1_WORKERS=1
